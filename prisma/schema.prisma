// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../libs/shared/src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  PUBLIC
  CLIENT
  CANDIDATE_KBS
  KCA_CERTIFIED
  AGENT
  KAMNET_ADMIN
  KAMNET_ROOT
  ADMIN_GLOBAL
  PARTNER_GEO
}

enum AgentLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
}

enum KBSCandidateStatus {
  CANDIDATE
  IN_TRAINING
  EXAM_PENDING
  CERTIFIED
  FAILED
}

enum KBSLessonContentType {
  VIDEO
  PDF
  MARKDOWN
  HTML
}

enum KBSExamStatus {
  SCHEDULED
  SUBMITTED
  PASSED
  FAILED
}

enum KCACertificateStatus {
  VALID
  EXPIRED
  REVOKED
}

model Role {
  id        String   @id @default(uuid())
  name      GlobalRole @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     UserRole[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  status    String?  @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     UserRole[]
  profile   Profile? @relation("UserProfile")

  kbscandidateProfile KBSCandidate?
  sponsoredKBSCandidates KBSCandidate[] @relation("SponsorKBSCandidate")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String @unique
  firstName String
  lastName  String
  phone     String?
  locale    String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserProfile", fields: [userId], references: [id])
}

// <-- KBS & KCA --> //

model KBSCandidate {
  id       String   @id @default(uuid())
  userId   String @unique
  sponsorId String?
  status   KBSCandidateStatus @default(CANDIDATE)
  enrollMentDate DateTime @default(now())
  examDueDate DateTime?
  kcaId String? @unique
  examId String?

  user      User     @relation(fields: [userId], references: [id])
  exam      KBSExam?
  certificate KCACertificate? @relation(fields: [kcaId], references: [id])
  sponsor   User?     @relation("SponsorKBSCandidate", fields: [sponsorId], references: [id])

  kbsprogresses KBSProgress[]
}

model KBSExam {
  id String @id @default(uuid())
  candidateId String @unique
  score Int?
  status KBSExamStatus @default(SCHEDULED)
  takenAt DateTime?

  candidate KBSCandidate @relation(fields: [candidateId], references: [id])
}

model KCACertificate {
  id String @id @default(uuid())
  candidateId String @unique
  issuedDate DateTime @default(now())
  validUntil DateTime
  pdfUrl String
  status KCACertificateStatus @default(VALID)
  createdAt DateTime @default(now())

  candidate KBSCandidate?
}

model KBSCourse {
  id String @id @default(uuid())
  title String
  description String
  slug String @unique
  language String @default("fr")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kbsmodules KBSModule[]
}

model KBSModule {
  id String @id @default(uuid())
  courseId String
  title String
  description String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course KBSCourse @relation(fields: [courseId], references: [id])
  kbslessons KBSLesson[]
  kbsprogresses KBSProgress[]
  kbsquestions KBSQuestion[]
}

model KBSLesson {
  id String @id @default(uuid())
  moduleId String
  title String
  contentType KBSLessonContentType @default(MARKDOWN)
  contentUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module KBSModule @relation(fields: [moduleId], references: [id])
}
model KBSProgress {
  id String @id @default(uuid())
  candidateId String
  moduleId String
  score Int?
  completedAt DateTime?

  candidate KBSCandidate @relation(fields: [candidateId], references: [id])
  module KBSModule @relation(fields: [moduleId], references: [id])

  @@unique([candidateId, moduleId])
}

model KBSQuestion {
  id String @id @default(uuid())
  moduleId String
  text String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module KBSModule @relation(fields: [moduleId], references: [id])
  answers KBSAnswer[]
}

model KBSAnswer {
  id String @id @default(uuid())
  questionId String
  text String
  isCorrect Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question KBSQuestion @relation(fields: [questionId], references: [id])
}
