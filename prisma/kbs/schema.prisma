generator client {
  provider = "prisma-client"
  output   = "../../libs/common/src/prisma/kbs-client"
}

datasource db {
  provider = "postgresql"
}

/// KBS Module: Training, Exams, and Certifications
model KbsCourse {
  id          String   @id @default(uuid())
  title       String   @unique
  description String
  slug        String?
  language    String?  @default("fr")
  isPublished Boolean  @default(false)
  /// Estimated total duration in minutes.
  duration    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules KbsModule[]
}

model KbsModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course        KbsCourse              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       KbsLesson[]
  /// Quiz questions associated with the module.
  questions     KbsQuestion[]
  /// Exam questions categorized by this module.
  examQuestions KbsExamQuestion[]
  progress      KbsCandidateProgress[]

  @@unique([courseId, order])
}

model KbsLesson {
  id          String   @id @default(uuid())
  moduleId    String
  title       String
  /// Content type format (e.g., video, pdf, html, text).
  contentType String
  /// S3 key or external URL for video and PDF lessons.
  contentUrl  String?
  /// Inline body content for HTML and text lessons.
  content     String?  @db.Text
  /// Estimated duration in minutes.
  duration    Int
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module             KbsModule               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonCompletions  KbsLessonCompletion[]
  media              KbsLessonMedia[]

  @@unique([moduleId, order])
}

/// Pending or fulfilled media slot within a lesson.
/// Created with a null URL; updated upon media upload.
model KbsLessonMedia {
  id        String   @id @default(uuid())
  lessonId  String
  /// Media kind. Constrained by LESSON_MEDIA_KINDS in libs/common/src/constants/kbs/lesson-media.ts.
  /// Omitted as a Prisma enum to prevent schema drift.
  kind      String
  /// Order of this media slot within the lesson, starting from 1.
  position  Int
  /// Descriptive label for the media slot.
  label     String
  /// S3 key or external URL. Null until the media file is uploaded.
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson KbsLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId])
}

model KbsLessonCompletion {
  id          String   @id @default(uuid())
  candidateId String
  lessonId    String
  completedAt DateTime @default(now())

  candidate KbsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  lesson    KbsLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([candidateId, lessonId])
}

model KbsQuestion {
  id        String   @id @default(uuid())
  moduleId  String
  text      String
  /// Question type (SINGLE or MULTIPLE).
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module  KbsModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  answers KbsAnswer[]
}

model KbsAnswer {
  id         String   @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question KbsQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model KbsExamQuestion {
  id        String   @id @default(uuid())
  moduleId  String
  text      String
  /// Question type (SINGLE or MULTIPLE).
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module      KbsModule               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  answers     KbsExamQuestionAnswer[]
  examAnswers KbsExamAnswer[]
}

model KbsExamQuestionAnswer {
  id         String   @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question   KbsExamQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selections KbsExamAnswerSelection[]
}

model KbsCandidate {
  id                 String    @id @default(uuid())
  userId             String    @unique
  sponsorCode        String?
  cvUrl              String?
  engagementAcceptedAt DateTime?
  /// Candidate lifecycle state (CANDIDATE, IN_TRAINING, EXAM_PENDING, CERTIFIED, FAILED).
  status             String
  maxAttempts        Int       @default(3)
  retakeCooldownDays Int       @default(7)
  currentCycle       Int       @default(1)
  enrolledAt         DateTime  @default(now())
  certifiedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  progress           KbsCandidateProgress[]
  lessonCompletions  KbsLessonCompletion[]
  exams              KbsExam[]
  /// Historical log of issued certificates.
  certificates       KbsCertificate[]
}

model KbsCandidateProgress {
  id          String    @id @default(uuid())
  candidateId String
  moduleId    String
  /// Quiz score percentage (0-100).
  score       Int?
  passed      Boolean   @default(false)
  /// Total quiz submissions for this module.
  attempts    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate KbsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  module    KbsModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([candidateId, moduleId])
}

model KbsExam {
  id              String    @id @default(uuid())
  candidateId     String
  attemptNumber   Int
  /// Exam score percentage (0-100).
  score           Int?
  passingScore    Int       @default(75)
  /// Exam lifecycle state (SCHEDULED, IN_PROGRESS, SUBMITTED, PASSED, FAILED, CANCELLED).
  status          String    @default("SCHEDULED")
  cycle           Int       @default(1)
  durationMinutes Int       @default(60)
  totalQuestions  Int       @default(0)
  scheduledAt     DateTime?
  startedAt       DateTime?
  submittedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  candidate   KbsCandidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  examAnswers KbsExamAnswer[]

  @@index([candidateId, cycle])
}

model KbsExamAnswer {
  id              String    @id @default(uuid())
  examId          String
  questionId      String
  flagged         Boolean   @default(false)
  /// Indicates answer correctness. Null until graded.
  questionCorrect Boolean?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  answeredAt      DateTime  @default(now())

  exam       KbsExam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   KbsExamQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selections KbsExamAnswerSelection[]

  @@unique([examId, questionId])
}

model KbsExamAnswerSelection {
  id           String   @id @default(uuid())
  examAnswerId String
  answerId     String
  /// Snapshot of answer correctness at grading time. Null until graded.
  wasCorrect   Boolean?

  examAnswer KbsExamAnswer         @relation(fields: [examAnswerId], references: [id], onDelete: Cascade)
  answer     KbsExamQuestionAnswer @relation(fields: [answerId], references: [id])

  @@unique([examAnswerId, answerId])
}

/// KBS module global configuration singleton.
model KbsSettings {
  id                Int      @id @default(autoincrement())
  activeCourseId    String?
  examQuestionCount Int      @default(20)
  quizQuestionCount Int      @default(10)
  quizMaxAttempts   Int      @default(5)
  quizCooldownMinutes Int      @default(60)
  updatedAt         DateTime @updatedAt
}

model KbsCertificate {
  id          String    @id @default(uuid())
  /// Associated candidate. Supports multiple records for renewals.
  candidateId String
  /// Unique certification number (e.g., KCA-YYYYMMDD-XXXX).
  kcaNumber   String    @unique
  issueDate   DateTime  @default(now())
  /// Expiration date of the certificate.
  validUntil  DateTime
  pdfUrl      String?
  /// Identifier of the admin user who issued the certificate.
  issuedBy    String?
  /// Timestamp when the certificate was revoked.
  revokedAt   DateTime?
  /// Identifier of the admin user who revoked the certificate.
  revokedBy   String?
  /// Reason for revoking the certificate.
  revokeReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate KbsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}
