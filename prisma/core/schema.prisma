generator client {
  provider = "prisma-client"
  output   = "../../libs/common/src/prisma/core-client"
}

datasource db {
  provider = "postgresql"
}

/// Core module containing schemas for user management, role-based access control, and authentication.

/// Represents a system user.
model User {
  /// Unique identifier for the user.
  id                String   @id @default(uuid())
  /// The user's email address.
  email             String   @unique
  /// Nullable. A null value indicates that no password has been set (e.g., for bootstrapped accounts).
  /// The password is set during the standard password reset flow, which also marks the email as verified.
  /// Login is refused if this field is null.
  passwordHash      String?
  firstName         String
  lastName          String
  phone             String?
  /// Indicates if the user account is currently active.
  isActive          Boolean  @default(true)
  /// Indicates if the user's email address has been verified.
  emailVerified     Boolean  @default(false)
  preferredLanguage String   @default("fr")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deactivatedBy String?

  pendingEmail  String?

  lastLoginAt   DateTime?
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?

  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  profile             UserProfile?
  verificationTokens  VerificationToken[]
  emailDeliveryEvents EmailDeliveryEvent[]
}

/// Represents a system role for access control.
model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  userRoles UserRole[]
}

/// Associates users with roles.
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

/// Stores extended profile information and preferences for a user.
model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  /// URL or storage key for the user's avatar.
  avatarUrl String?
  address   String?
  city      String?
  country   String?

  /// Indicates if the user receives email notifications.
  emailNotifications  Boolean @default(false)

  /// DEPRECATED by A12. There is no WhatsApp sender in the API, so the
  /// preference was removed from every surface; the column is retained so no
  /// stored value is lost. Pinned by no-unbacked-preference.spec.ts.
  whatsappNotifications  Boolean @default(false)

  /// The user's last preferred payment channel.
  /// Used as a default selection for subsequent transactions.
  /// Stored as a string code (e.g., 'VIR', 'DEPO', 'OMO', 'MOMO', 'ESP', 'NOTA')
  /// since the corresponding enum resides in the lands database.
  preferredPaymentChannel String?

  /// URLs to the identity documents submitted by the user.
  idDocumentUrls       String[]  @default([])
  /// The current status of identity verification ('none', 'pending', 'verified', 'rejected').
  idVerificationStatus String    @default("none")
  /// The timestamp when the identity documents were submitted.
  idSubmittedAt        DateTime?
  idVerifiedAt         DateTime?
  idVerifiedBy         String?
  idRejectionReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Represents a refresh token for authentication.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

/// Represents a verification token for actions such as email verification or password resets.
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  /// The type of verification ('email_verification', 'password_reset', 'email_change').
  type      String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([token])
}

/// The subject of the contact request.
enum ContactSubject {
  LANDS
  VERIFY
  KAMNET
  KBS
  PARTNERSHIP
  OTHER
}

/// The processing status of the contact request.
enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

/// Represents a generic inbound contact request from the public site.
/// This model is module-agnostic and captures inquiries before a user creates an account.
/// It is distinct from domain-specific leads (e.g., KamnetLead) as it is not assigned to an agent by default.
model ContactRequest {
  id String @id @default(uuid())

  name  String
  email String
  /// The user's phone number.
  phone String?

  /// The category of the contact request.
  subject ContactSubject
  /// The main content of the request.
  message String

  /// The locale of the application when the request was made. Used for localized communication.
  locale String @default("fr")

  /// The server-side timestamp when privacy policy consent was granted.
  /// This is required for compliance and must always be recorded.
  consentGivenAt DateTime

  /// The policy document consented to, as a path: `/legal/privacy`. Names the
  /// document and not the wording, which is what the snapshot below adds.
  consentPolicyPath String

  /// The archived revision of that policy that was current when consent was
  /// given, resolved server-side. Null means nothing was archived yet, which is
  /// reported in the daily digest rather than left as a silent gap.
  consentPolicySnapshotId String?
  consentPolicySnapshot   PolicySnapshot? @relation(fields: [consentPolicySnapshotId], references: [id])

  status ContactRequestStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Index for optimizing time-based queries.
  @@index([createdAt])
  @@index([status])
  @@index([consentPolicySnapshotId])
}

/// An immutable copy of a published policy document, as a reader saw it.
///
/// Consent is to a document, and documents change. `ContactRequest` already
/// records what was consented to - and records it as `/legal/privacy`, a path,
/// which names the document and not the version. A row that says somebody
/// agreed to the privacy policy, with no way to show which words those were,
/// answers nothing the day it is asked.
///
/// Sanity keeps 3 days of revision history on the plan this project uses, so
/// `revision` is provenance and never a way to retrieve the content later: by
/// the time a consent record is questioned, the revision it names is gone.
/// The rendered bytes are therefore stored here, not referenced.
///
/// Append-only at the database, by trigger. A correction is a new row.
model PolicySnapshot {
  id String @id @default(uuid())

  /// The Sanity document (`_id`) this copy was taken from.
  documentId String
  /// The Sanity revision (`_rev`) this copy was taken from.
  revision   String
  /// The language of the document, which under document-level i18n is a
  /// property of the document rather than of a field.
  locale     String
  /// The policy this document is, independent of Sanity: `legal-privacy`.
  /// What a caller looks up when it needs the version current right now.
  slug       String

  /// The document rendered to HTML, exactly as it was served.
  rendered String

  /// When Sanity published this revision.
  publishedAt DateTime
  /// When this archive received it. Distinct from publishedAt: a webhook can
  /// arrive late, and the difference is the thing worth seeing.
  archivedAt  DateTime @default(now())

  /// The consents given to this exact wording.
  consents ContactRequest[]

  /// One row per revision. A webhook that fires twice must not archive twice.
  @@unique([documentId, revision])
  /// "The version of this policy current at that moment", which is the query
  /// consent depends on.
  @@index([slug, locale, publishedAt])
}

/// What SES reported about a message the API sent: a bounce or a complaint.
enum EmailDeliveryEventKind {
  BOUNCE
  COMPLAINT
}

/// A bounce or complaint SES published for one recipient of one message (C24).
/// Written only from a verified SNS delivery; `userId` is set when the address
/// belongs to an account when the event arrives.
model EmailDeliveryEvent {
  id           String                 @id @default(uuid())
  /// SES feedback id. With `email`, identifies one event, so a redelivered
  /// notification is stored once.
  feedbackId   String
  email        String
  kind         EmailDeliveryEventKind
  /// SES `bounceType` (Permanent, Transient, Undetermined) or the complaint feedback type.
  type         String?
  /// SES `bounceSubType`, for a bounce.
  subType      String?
  /// The SES message the event is about.
  sesMessageId String
  occurredAt   DateTime
  receivedAt   DateTime               @default(now())
  userId       String?
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([feedbackId, email])
  @@index([userId, occurredAt])
}

/// An administrative act on an account (C28 step 1): who changed what, when,
/// why, and from what to what. `User.deactivatedBy`, `UserRole.grantedBy` and
/// `UserProfile.idVerifiedBy` each hold only the last actor, and log lines are
/// kept for days; this record is kept for the life of the database.
///
/// Append-only at the database, by trigger: a correction is a new row. The
/// account ids are carried by value, without a foreign key, so the record of an
/// account outlives the account and deleting a user never has to edit it.
model AdministrativeAct {
  id            String   @id @default(uuid())
  /// The account the act was done to.
  subjectUserId String
  /// The administrator who did it.
  actorUserId   String
  /// What was done, as a stable code.
  action        String
  /// The attribute changed.
  field         String
  /// The value before the act; null when there was none.
  oldValue      String?
  /// The value after the act; null when the act removed it.
  newValue      String?
  /// Why, in the actor's words. Required and never blank.
  reason        String
  occurredAt    DateTime @default(now())

  @@index([subjectUserId, occurredAt])
}
