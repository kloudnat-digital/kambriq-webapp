generator client {
  provider = "prisma-client"
  output   = "../../libs/common/src/prisma/kamnet-client"
}

datasource db {
  provider = "postgresql"
}

/// Represents the classification tier of a KAMNET agent.
enum KamnetAgentTier {
  JUNIOR
  CONFIRMED
  MANAGER
}

/// The approval status of a KAMNET application.
enum KamnetApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The lifecycle status of a commission.
enum KamnetCommissionStatus {
  PENDING
  VALIDATED
  PAID
}

/// The acquisition source of a KAMNET lead.
enum KamnetLeadSource {
  SOCIAL_MEDIA
  REFERRAL
  EVENT
  OTHER
}

/// The current stage of a KAMNET lead in the sales pipeline.
enum KamnetLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

/// The processing status of a KAMNET reservation.
enum KamnetReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// KAMNET module for agent, commission, and lead management.

/// Represents an active KAMNET agent.
/// This record is created upon approval of a KamnetApplication.
/// Agents form a self-referencing hierarchy through sponsorship.
model KamnetAgent {
  id            String            @id @default(uuid())
  userId        String            @unique
  /// The KCA certificate identifier from the KBS module.
  kcaNumber     String
  /// Unique public identifier for the agent (e.g., AGT-2025-0001).
  agentCode     String            @unique
  /// Optional biographical information about the agent.
  bio           String?
  /// The current performance tier of the agent.
  tier        KamnetAgentTier @default(JUNIOR)
  /// The total number of successful sales, used for ranking and reward calculations.
  salesCount    Int               @default(0)

  /// The ID of the sponsoring agent. Nullable for top-level agents.
  sponsorId    String?
  sponsor      KamnetAgent?    @relation("SponsorshipTree", fields: [sponsorId], references: [id])
  referrals    KamnetAgent[]   @relation("SponsorshipTree")

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  suspendedAt   DateTime?
  suspendedBy    String?

  commissions  KamnetCommission[]
  leads        KamnetLead[]

  @@index([tier])
  @@index([sponsorId])
}

/// Represents an application submitted by a KCA certified user to join KAMNET.
/// Approved applications result in the creation of a KamnetAgent record.
model KamnetApplication {
  id          String                  @id @default(uuid())
  userId      String
  /// The applicant's KBS certificate identifier.
  kcaNumber   String
  /// The agent code of the sponsor, if applicable.
  sponsorCode String?
  /// The applicant's stated motivation for joining KAMNET.
  motivation  String?
  /// The current status of the application.
  status      KamnetApplicationStatus @default(PENDING)
  /// The ID of the administrator who reviewed the application.
  reviewedBy  String?
  /// Additional notes provided by the reviewer, typically used for rejections.
  reviewNote  String?
  /// The timestamp when the review was completed.
  reviewedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([userId])
  @@index([status])
}

/// Tracks commission records for sales.
/// Initially managed manually by administrators, with automated calculation planned for future iterations.
model KamnetCommission {
  id            String                  @id @default(uuid())
  agentId       String
  /// The external reference to the property in the LANDS module.
  landId        String
  /// The external reference to the reservation that triggered the commission.
  reservationId String
  /// The hierarchical level of the agent receiving the commission (e.g., 0 for Direct Agent, 1 for N1).
  level         Int                     @default(0)
  /// The product value coefficient (Point Valeur).
  pv            Float
  /// The commission rate applied (Taux Part Commission).
  tpc           Float
  /// The calculated commission amount in the local currency (XAF).
  amount        Float
  status        KamnetCommissionStatus  @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  agent         KamnetAgent             @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([status])
}

/// Represents a prospective client tracked by a KAMNET agent prior to a formal reservation.
model KamnetLead {
  id          String                  @id @default(uuid())
  agentId     String
  clientName  String
  clientEmail String?
  clientPhone String?
  source      KamnetLeadSource?
  notes       String?
  status      KamnetLeadStatus        @default(NEW)
  convertedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  deletedAt   DateTime?
  deletedBy   String?

  agent       KamnetAgent             @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([status])
}
