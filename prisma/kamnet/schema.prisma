
generator client {
  provider = "prisma-client"
  output   = "../../libs/common/src/prisma/kamnet-client"
}

datasource db {
  provider = "postgresql"
}

enum KamnetAgentTier {
  JUNIOR
  CONFIRMED
  MANAGER
}

enum KamnetApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KamnetCommissionStatus {
  PENDING
  VALIDATED
  PAID
}

enum KamnetLeadSource {
  SOCIAL_MEDIA
  REFERRAL
  EVENT
  OTHER
}

enum KamnetLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum KamnetReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ----- KAMNET Module ----- //
/**
* Agent created when an admin approves a KAMNET application
* userId links to Core.User
* Sponsorship is a self-referencing tree (parent <-> children)
*/
model KamnetAgent {
  id            String            @id @default(uuid())
  userId        String            @unique
  kcaNumber     String            // KCA certificate from KBS
  agentCode     String            @unique // Unique public agent code (e.g. AGT-2025-0001)
  bio           String?
  tier        KamnetAgentTier @default(JUNIOR)
  salesCount    Int               @default(0) // Total number of successful sales (for ranking and rewards)

  // Sponsorship tree
  sponsorId    String?   // References the sponsoring agent (nullable for top-level agents)
  sponsor      KamnetAgent?    @relation("SponsorshipTree", fields: [sponsorId], references: [id])
  referrals    KamnetAgent[]   @relation("SponsorshipTree")

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  suspendedAt   DateTime?
  suspendedBy    String?

  /// P11 - when this agent agreed to appear in the public directory.
  ///
  /// Null means not listed, and null is the default for every row that already
  /// exists: nobody becomes published because a migration ran. Withdrawing
  /// consent writes null again, and the entry is gone from the next read.
  ///
  /// A nullable timestamp rather than a boolean, because "since when" is the
  /// fact a consent record has to be able to answer and a boolean cannot.
  ///
  /// Publishing a real person's name, face and city is not a rendering
  /// decision, so it is recorded here rather than inferred from a role, a tier
  /// or the existence of a certificate.
  publicListingConsentAt DateTime?

  // Relations
  commissions  KamnetCommission[]
  leads        KamnetLead[]

  @@index([tier])
  @@index([sponsorId])
}

// ----- KAMNET Application ----- //
/**
* A KCA certified user submits this to join KAMNET.
* Admin approves -> KAMNET record is created.
*/
model KamnetApplication {
  id          String                  @id @default(uuid())
  userId      String
  kcaNumber   String                  // Must match a valid KBS certificate
  sponsorCode String?                 // agent code of sponsor (optional)
  motivation  String?                 // Why they want to join KAMNET
  status      KamnetApplicationStatus @default(PENDING)
  reviewedBy  String?                 // admin userId who reviewed the application
  reviewNote  String?                 // optional admin note from the reviewer (especially if rejected)
  reviewedAt  DateTime?               // when the application was reviewed
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([userId])
  @@index([status])
}

// ----- Commission Trace ----- //
/**
* Stores comission records per sale.
* In MVP, these are created manually by admins.
* Auto calculation comes in V2
*/
model KamnetCommission {
  id            String                  @id @default(uuid())
  agentId       String
  landId        String                  // Reference to LANDS module
  reservationId String                  // Reference to reservation that triggered the sale
  level         Int                     @default(0) // 0 = DA (Direct Agent), 1 = N1, 2 = N2, 3 = N3
  pv            Float                   // Point Valeur (product value coefficient, 02 - 1.2)
  tpc           Float                   // Taux Part Commission (commission rate, e.g. 0.05 = 5%)
  amount        Float                   // Calculated commission amount in XAF
  status        KamnetCommissionStatus  @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  agent         KamnetAgent             @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([status])
}

// ----- Lead Tracking ----- //
/**
* Agents track their prospects before a reservation is made.
*/
model KamnetLead {
  id          String                  @id @default(uuid())
  agentId     String
  clientName  String
  clientEmail String?
  clientPhone String?
  source      KamnetLeadSource?
  notes       String?
  status      KamnetLeadStatus        @default(NEW)
  convertedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  deletedAt   DateTime?
  deletedBy   String?

  agent       KamnetAgent             @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([status])
}
