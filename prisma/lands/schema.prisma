generator client {
  provider        = "prisma-client"
  output          = "../../libs/common/src/prisma/lands-client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum LandLabelCodes {
  TFL
  VEFL
  VEFIL
}

enum LandStatus {
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum LandOwnerType {
  PARTNER
  KAMBRIQ
}

enum LandMediaType {
  IMAGE
  VIDEO
  MAP
}

enum LandDocumentType {
  TITLE_DEED
  SURVEY
  PERMIT
  RECEIPT
  OTHER
}

enum LandReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum LandClientDocumentType {
  ID_CARD
  PROOF_OF_ADDRESS
  OTHER
}

/// Lands Module
/// Classification of land titles (e.g., TFL, VEFL, VEFIL).
model LandLabel {
  id          String         @id @default(uuid())
  code        LandLabelCodes @unique
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lands Land[]
}

/// Core land parcel entity. Represents a verified, titled parcel available for sale.
model Land {
  id           String     @id @default(uuid())
  /// Display name.
  title        String
  /// URL-friendly identifier.
  slug         String     @unique
  /// Rich text description of the land.
  description  String
  /// Administrative region.
  region       String
  /// City or locality.
  city         String?
  /// Neighborhood or district.
  neighborhood String?
  /// Geographical latitude coordinate.
  latitude     Float?
  /// Geographical longitude coordinate.
  longitude    Float?
  /// Size of the land in square meters.
  sizeM2       Float
  /// Selling price in XAF.
  price        Float
  /// Identifier for the associated LandLabel.
  labelId      String
  status       LandStatus @default(AVAILABLE)
  /// Indicates whether the land is visible to clients.
  isPublished  Boolean    @default(false)

  /// Commission coefficient (Point Valeur) for agents.
  pv        Float         @default(1.0)
  ownerType LandOwnerType @default(KAMBRIQ)
  /// External partner identifier when ownerType is PARTNER.
  partnerId String?

  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  /// Reference identifier for external verification.
  verificationRef String?

  /// Official land title number.
  titleNumber  String? @unique
  /// Surface area as mentioned in the title document.
  surfaceTitle Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label        LandLabel          @relation(fields: [labelId], references: [id])
  media        LandMedia[]
  documents    LandDocument[]
  /// Reservations associated with this land.
  reservations LandReservation[]
  priceHistory LandPriceHistory[]

  @@index([status])
  @@index([region])
  @@index([labelId])
  @@index([price])
}

/// Public media assets (e.g., images, videos, maps) for a land parcel.
model LandMedia {
  id        String        @id @default(uuid())
  landId    String
  /// Type of media (IMAGE, VIDEO, MAP).
  type      LandMediaType
  /// S3 key or URL of the media file.
  url       String
  /// Optional description or caption.
  caption   String?
  /// Display order. The item with the lowest value is typically the primary media.
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  land Land @relation(fields: [landId], references: [id])

  @@index([landId])
}

/// Private legal and administrative documents associated with a land parcel.
model LandDocument {
  id         String           @id @default(uuid())
  landId     String
  /// Type of document.
  type       LandDocumentType
  /// Display name of the document.
  name       String
  /// S3 key or URL of the document file.
  url        String
  /// Identifier of the user who uploaded the document.
  uploadedBy String
  /// Indicates if the document is strictly private.
  isPrivate  Boolean          @default(true)
  createdAt  DateTime         @default(now())

  land Land @relation(fields: [landId], references: [id])

  @@index([landId])
}

/// Documents uploaded by clients during the land purchase process.
model LandClientDocument {
  id            String                 @id @default(uuid())
  reservationId String
  type          LandClientDocumentType
  name          String
  /// S3 key or URL of the document file.
  url           String
  uploadedAt    DateTime               @default(now())
  /// Identifier of the client who uploaded the document.
  uploadedBy    String

  /// Timestamp when the document was soft-deleted or rejected.
  deletedAt       DateTime?
  /// Identifier of the user who deleted or rejected the document.
  deletedBy       String?
  /// Reason provided for rejection.
  rejectionReason String?

  reservation LandReservation @relation(fields: [reservationId], references: [id])

  /// Multiple historical soft-deleted records are permitted per reservation and document type.
  @@index([reservationId, type])
  @@index([reservationId])
}

/// Land reservation record. Enforces a single active reservation per land.
model LandReservation {
  id           String                @id @default(uuid())
  landId       String
  /// Identifier of the agent facilitating the reservation.
  agentUserId  String
  /// Identifier of the client holding the reservation.
  clientUserId String?
  clientName   String
  clientEmail  String
  clientPhone  String?
  status       LandReservationStatus @default(PENDING)

  /// Deprecated legacy payment fields.
  /// Superseded by the explicit Payment, PaymentReceipt, and PaymentTransition models.
  /// Legacy down payment amount in XAF.
  downPaymentAmount    Float?
  downPaymentConfirmed Boolean   @default(false)
  /// Identifier of the admin who confirmed the down payment.
  confirmedBy          String?
  confirmedAt          DateTime?

  /// Tracks when client verification documents were received.
  documentsReceivedAt DateTime?
  /// Identifier of the admin who received the documents.
  documentsReceivedBy String?

  /// Tracks when the final payment was confirmed.
  remainingPaymentConfirmedAt DateTime?
  /// Identifier of the admin who confirmed the final payment.
  remainingPaymentConfirmedBy String?

  /// Tracks when the title transfer dossier was initiated.
  dossierStartedAt DateTime?
  /// Identifier of the admin who started the dossier.
  dossierStartedBy String?

  /// Tracks when the sale was finalized.
  completedAt DateTime?
  /// Identifier of the admin who completed the sale.
  completedBy String?

  cancelReason String?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  land                Land                 @relation(fields: [landId], references: [id])
  landClientDocuments LandClientDocument[]
  payments            Payment[]

  /// Unique constraint to ensure only one active reservation per land.
  @@unique([landId], where: { status: { not: "CANCELLED" } })
  @@index([agentUserId])
  @@index([status])
}

/// Audit log for price changes on land parcels.
model LandPriceHistory {
  id            String   @id @default(uuid())
  landId        String
  previousPrice Float
  newPrice      Float
  /// Identifier of the admin who updated the price.
  changedBy     String
  /// Reason for the price update.
  reason        String
  changedAt     DateTime @default(now())

  land Land @relation(fields: [landId], references: [id])

  @@index([landId])
}

/// Payment processing and state machine models.
/// Orchestrates and records payment receipts across external channels.

/// Represents the lifecycle states of a payment.
enum PaymentState {
  INITIE
  INSTRUCTIONS_ENVOYEES
  ANNONCE_CLIENT
  EN_VERIFICATION
  PARTIELLEMENT_RECU
  VALIDE
  REJETE
  EXPIRE
  ANNULE
}

/// Payment methods and channels used for transactions.
enum PaymentChannel {
  VIR
  DEPO
  OMO
  MOMO
  ESP
  NOTA
  /// Historical marker for legacy payment records that lacked channel tracking.
  HIST
}

model Payment {
  id String @id @default(uuid())

  /// Unique payment reference identifier.
  reference String? @unique

  reservationId String

  /// ISO 4217 currency code.
  currency String

  /// Due amount stored in indivisible integer units to prevent floating point imprecision.
  amountDue BigInt

  state PaymentState @default(INITIE)

  /// Client's initially requested payment channel.
  preferredChannel PaymentChannel?

  /// Authoritative payment channel assigned by the back office.
  channel PaymentChannel?

  /// Expiration timestamp for the payment request.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservation LandReservation     @relation(fields: [reservationId], references: [id])
  receipts    PaymentReceipt[]
  transitions PaymentTransition[]
  reminders   PaymentReminder[]

  @@index([reservationId])
  @@index([state])
}

/// Immutable ledger of received funds and corrections for a payment.
model PaymentReceipt {
  id        String @id @default(uuid())
  paymentId String

  /// Received amount in indivisible integer units. Supports negative values for corrections.
  amount   BigInt
  currency String

  channel PaymentChannel

  /// Timestamp indicating when the funds were physically or electronically received.
  receivedAt DateTime
  recordedAt DateTime @default(now())

  /// Identifier of the user who recorded this receipt.
  recordedBy String

  /// File URL or S3 key containing proof of payment.
  evidenceUrl String?

  /// Name of the third-party individual who made the deposit, if applicable.
  paidBy String?

  /// Reference to the specific receipt this line corrects, if applicable.
  correctsId String?
  note       String?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([correctsId])
}

/// Immutable audit log capturing payment state transitions.
model PaymentTransition {
  id        String @id @default(uuid())
  paymentId String

  /// Previous state of the payment. Null for the initial creation event.
  fromState PaymentState?
  toState   PaymentState

  /// Identifier of the user who initiated the transition.
  actorUserId String
  reason      String

  /// Reference to the associated payment receipt, if applicable.
  evidenceReceiptId String?

  /// Specific payment channel involved in this state transition.
  channel PaymentChannel?

  /// Snapshot of the payment instructions or details communicated during this transition.
  communicatedDetails Json?

  occurredAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([occurredAt])
}

/// Audit record of automated or manual payment reminders sent to the client.
model PaymentReminder {
  id        String @id @default(uuid())
  paymentId String

  /// Number of days before the deadline this reminder represents.
  offsetDays Int

  /// Payment deadline timestamp at the time the reminder was dispatched.
  deadlineAt DateTime

  sentAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, offsetDays])
  @@index([paymentId])
  @@index([sentAt])
}
