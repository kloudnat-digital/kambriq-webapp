{
  "name": "@kambriq/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "----- API -----": "",
    "start": "npx nx serve api",
    "start:dev": "npx nx serve api",
    "start:prod": "node dist/apps/api/main.js",
    "build": "npx nx build api",
    "----- WEB -----": "",
    "start:web": "npx nx dev web",
    "build:web": "npx nx build web",
    "test:web": "npx nx test web",
    "test:web:e2e": "npx nx e2e web-e2e",
    "test:e2e": "npx nx e2e web-e2e",
    "test:e2e:ci": "BASE_URL=$BASE_URL npx nx e2e web-e2e",
    "test:e2e:report": "npx playwright show-report apps/web-e2e/playwright-report",
    "----- CODE QUALITY -----": "",
    "lint": "npx nx lint api",
    "lint:web": "npx nx lint web",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.app.json",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "----- TESTING -----": "",
    "test": "npx nx run-many -t test --projects=api,common",
    "test:api": "npx nx test api",
    "test:common": "npx nx test common",
    "test:cov": "npx nx run-many -t test --projects=api,common --coverage",
    "test:cov:api": "npx nx test api --coverage",
    "test:cov:common": "npx nx test common --coverage",
    "----- DATABASE -----": "",
    "db:generate:core": "npx prisma generate --schema prisma/core/schema.prisma",
    "db:generate:kbs": "npx prisma generate --schema prisma/kbs/schema.prisma",
    "db:generate:kamnet": "npx prisma generate --schema prisma/kamnet/schema.prisma",
    "db:generate:lands": "npx prisma generate --schema prisma/lands/schema.prisma",
    "db:migrate:dev:core": "npx prisma migrate dev --schema prisma/core/schema.prisma --config prisma/core/prisma.config.ts",
    "db:migrate:dev:kbs": "npx prisma migrate dev --schema prisma/kbs/schema.prisma --config prisma/kbs/prisma.config.ts",
    "db:migrate:dev:kamnet": "npx prisma migrate dev --schema prisma/kamnet/schema.prisma --config prisma/kamnet/prisma.config.ts",
    "db:migrate:dev:lands": "npx prisma migrate dev --schema prisma/lands/schema.prisma --config prisma/lands/prisma.config.ts",
    "db:migrate:dev": "pnpm run db:migrate:dev:core && pnpm run db:migrate:dev:kbs && pnpm run db:migrate:dev:kamnet && pnpm run db:migrate:dev:lands",
    "db:migrate:deploy:core": "npx prisma migrate deploy --schema prisma/core/schema.prisma --config prisma/core/prisma.config.ts",
    "db:migrate:deploy:kbs": "npx prisma migrate deploy --schema prisma/kbs/schema.prisma --config prisma/kbs/prisma.config.ts",
    "db:migrate:deploy:kamnet": "npx prisma migrate deploy --schema prisma/kamnet/schema.prisma --config prisma/kamnet/prisma.config.ts",
    "db:migrate:deploy:lands": "npx prisma migrate deploy --schema prisma/lands/schema.prisma --config prisma/lands/prisma.config.ts",
    "db:migrate:deploy": "pnpm run db:migrate:deploy:core && pnpm run db:migrate:deploy:kbs && pnpm run db:migrate:deploy:kamnet && pnpm run db:migrate:deploy:lands",
    "db:studio:core": "npx prisma studio --config=prisma/core/prisma.config.ts --port 5555",
    "db:studio:kbs": "npx prisma studio --config=prisma/kbs/prisma.config.ts --port 5556",
    "db:studio:kamnet": "npx prisma studio --config=prisma/kamnet/prisma.config.ts --port 5557",
    "db:studio:lands": "npx prisma studio --config=prisma/lands/prisma.config.ts --port 5558",
    "db:studio": "pnpm run db:studio:core && pnpm run db:studio:kbs && pnpm run db:studio:kamnet && pnpm run db:studio:lands",
    "db:reset:core": "npx prisma migrate reset --config prisma/core/prisma.config.ts --schema prisma/core/schema.prisma",
    "db:reset:kbs": "npx prisma migrate reset --config prisma/kbs/prisma.config.ts --schema prisma/kbs/schema.prisma",
    "db:reset:kamnet": "npx prisma migrate reset --config prisma/kamnet/prisma.config.ts --schema prisma/kamnet/schema.prisma",
    "db:reset:lands": "npx prisma migrate reset --config prisma/lands/prisma.config.ts --schema prisma/lands/schema.prisma",
    "db:reset": "pnpm run db:reset:core && pnpm run db:reset:kbs && pnpm run db:reset:kamnet && pnpm run db:reset:lands",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "pnpm run db:migrate:dev && pnpm run db:seed",
    "----- NX -----": "",
    "nx:graph": "npx nx graph",
    "nx:reset": "npx nx reset",
    "----- DOCKER -----": "",
    "docker:dev:init": "docker compose -f docker/docker-compose.yml up -d --wait && pnpm run db:setup",
    "docker:dev": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:dev:reset": "docker compose -f docker/docker-compose.yml down -v",
    "docker:dev:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:build": "docker build -f docker/Dockerfile.api -t kambriq-api .",
    "postinstall": "pnpm run db:generate:core && pnpm run db:generate:kbs && pnpm run db:generate:kamnet && pnpm run db:generate:lands",
    "prepare": "husky || true"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^10.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "**/*.{css,json,md}": [
      "prettier --write"
    ]
  },
