# Enforce the Node version declared in package.json engines.
#
# CI and both runtime images run Node 24. Without this, a machine on another
# major prints a warning and continues, so a local pass says nothing about the
# runtime that is deployed.
#
# `.nvmrc` carries `24`, matching the CI pin. The runtime images pin
# node:24.13.1-bookworm, so the three agree at the major only.
engine-strict=true
