# ----- KAMBRIQ API - Production Dockerfile ----- #

FROM node:24.13.1-bookworm AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma

RUN pnpm install --frozen-lockfile
RUN npx prisma generate --schema prisma/core/schema.prisma && \
    npx prisma generate --schema prisma/kbs/schema.prisma && \
    npx prisma generate --schema prisma/kamnet/schema.prisma && \
    npx prisma generate --schema prisma/lands/schema.prisma

COPY tsconfig.base.json ./
COPY apps/api ./apps/api/
COPY libs ./libs/

RUN pnpm run build

# ----- Production image -----
FROM node:24.13.1-bookworm-slim AS production

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -m -s /usr/sbin/nologin appuser

RUN apt-get update && apt-get install -y --no-install-recommends openssl curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=builder /app/prisma ./prisma/

# Pre-create Prisma client output dirs so the postinstall (prisma generate) can write.
# The generated clients are overwritten by the COPY from builder below, but the
# engine binaries extracted here (as root) remain - preventing EACCES when the
# non-root appuser runs migrations at deploy time.
RUN mkdir -p libs/common/src/prisma/core-client \
             libs/common/src/prisma/kbs-client \
             libs/common/src/prisma/kamnet-client \
             libs/common/src/prisma/lands-client && \
    pnpm install --frozen-lockfile --prod && \
    pnpm store prune

# The whole of libs/common/src, not two chosen subdirectories.
#
# This used to copy only `prisma/` and `i18n/`, which is everything the compiled
# API needs — `dist/apps/api/main.js` has the rest bundled. But `prisma/seed.ts`
# runs from SOURCE under tsx, so it resolves imports against this tree, and the
# moment it imported `libs/common/src/types/roles.enum` the seed died in the
# container with `Cannot find module`. It had run clean locally minutes before:
# **a green local run says nothing about a tree the image does not carry.**
#
# Copying the directory rather than a list of its children means the next import
# the seed needs is already there, instead of failing once in production and
# being fixed once.
COPY --from=builder /app/libs/common/src ./libs/common/src

# tsconfig.base.json, because a source-run script needs it at RUNTIME.
#
# `tsx` resolves `tsconfig.json` from the working directory and this repo has
# none at the root, so esbuild falls back to its defaults - in which
# `experimentalDecorators` is FALSE. `prisma/bootstrap-admins.ts` imports
# `EmailService`, whose constructor carries `@InjectQueue(...)`, a parameter
# decorator. Without this file and the `--tsconfig` flag the script dies with
# "Parameter decorators only work when experimental decorators are enabled" -
# in the container, having run clean locally, which is the exact class of defect
# the COPY above was added for.
COPY --from=builder /app/tsconfig.base.json ./

COPY --from=builder /app/dist/apps/api ./dist/apps/api

# ----- Build metadata -----
# Filled by ci.yml from the commit being built. Placed late so a metadata-only
# change does not invalidate the dependency and build layers above.
ARG GIT_SHA=unknown
ARG GIT_REF=unknown
ARG BUILD_TIME=unknown
ARG IMAGE_TAG=unknown
ARG APP_VERSION=unknown
ENV GIT_SHA=${GIT_SHA} \
    GIT_REF=${GIT_REF} \
    BUILD_TIME=${BUILD_TIME} \
    IMAGE_TAG=${IMAGE_TAG} \
    APP_VERSION=${APP_VERSION}
LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${IMAGE_TAG}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.source="https://github.com/kloudnat-digital/kambriq-webapp"

USER appuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/api/v1/health/ready || exit 1

CMD ["node", "dist/apps/api/main.js"]
