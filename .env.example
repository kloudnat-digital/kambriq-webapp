NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# DB
DATABASE_URL_CORE=postgresql://postgres:password@localhost:5432/kambriq_core
DATABASE_URL_KBS=postgresql://postgres:password@localhost:5432/kambriq_kbs
DATABASE_URL_KAMNET=postgresql://postgres:password@localhost:5432/kambriq_kamnet
DATABASE_URL_LANDS=postgresql://postgres:password@localhost:5432/kambriq_lands
# Optional - no schema or client exists for these yet
DATABASE_URL_VERIFY=postgresql://postgres:password@localhost:5432/kambriq_verify
DATABASE_URL_VALUATION=postgresql://postgres:password@localhost:5432/kambriq_valuation

JWT_SECRET=dev-secret-minimum-32-characters-long-change-in-prod!!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=15d

# The web app runs on 3001 (nx dev web --port 3001); the API is on 3000.
CORS_ORIGINS=http://localhost:3001

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS
#
# There is deliberately no AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
# Nothing reads them. SES and S3 both resolve credentials through the default
# provider chain - the ECS task role on Fargate, your ~/.aws profile locally.
# They used to be listed, and StorageService used to gate on them, so on Fargate
# the S3 client was never built and every upload returned an unusable URL with
# HTTP 200 from February to September 2026. Do not reintroduce them.
#
# eu-central-1 is where every Kambriq resource lives: RDS, ECS, SES, SSM.
AWS_REGION=eu-central-1
AWS_SES_CONTACT_LIST_NAME=kambriq-newsletter

# Storage transport
#
# 'disabled' is the default here so a fresh clone boots without an S3 bucket.
# Storage calls then throw a named error instead of returning something that
# looks like it worked. To exercise uploads locally, set STORAGE_TRANSPORT=s3
# and fill in both variables below - with 's3' and either one empty, the API
# refuses to start, which is intended.
STORAGE_TRANSPORT=disabled
AWS_S3_BUCKET=
AWS_S3_REGION=eu-central-1

# Email transport
#
# 'console' logs the message instead of sending it. Keep it that way locally:
# the schema default is 'ses', so an unset value sends real mail through SES.
# A degraded path must be asked for explicitly, never inferred from absent
# configuration - that inference is why the platform silently sent nothing for
# months while reporting success.
EMAIL_TRANSPORT=console
EMAIL_FROM=noreply@kambriq.com
EMAIL_FROM_NAME=KAMBRIQ

# Frontend origin - every transactional email link is built from this.
FRONTEND_URL=http://localhost:3001
