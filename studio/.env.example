# The Studio reads variables prefixed SANITY_STUDIO_ and nothing else. Copy this
# to .env after `npx sanity projects create` has created the project.
#
# These are not secrets: a project id and a dataset name are public, and the
# Studio authenticates the person, not the build.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# The hostname the Studio is deployed under, without the .sanity.studio suffix.
# `sanity deploy` prompts for this when it is absent, which makes the first
# deploy interactive and every later one different from it.
SANITY_STUDIO_HOST=kambriq
