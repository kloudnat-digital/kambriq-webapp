{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    // Matches tsconfig.app.json. Inherited from tsconfig.base.json this was
    // es2015, so the specs compiled at a lower target than the code they test
    // and rejected BigInt literals that `tsc -p tsconfig.app.json` accepts. A
    // test configuration that disagrees with the build configuration reports a
    // defect in itself as a defect in the code.
    "target": "es2021",
    "moduleResolution": "node10",
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.dbspec.ts",
    "src/**/*.d.ts"
  ]
}
