# API
# Backend base URL (Next.js exposes NEXT_PUBLIC_* vars to the browser)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Frontend URL (for callbacks, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Auth (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-minimum-32-characters

# Mapbox
# Get your token at https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Auth Secret
BETTER_AUTH_SECRET=your-better-auth-secret-minimum-32-characters


# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_DEVTOOLS=true
