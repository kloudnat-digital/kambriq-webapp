{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": ["type:app", "scope:web"],
  "targets": {
    "dev": {
      "options": {
        "args": "--port 3001"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/docker/Dockerfile.web",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/.github/workflows/manual-deploy-dev.yml",
        "{workspaceRoot}/libs/common/src/i18n/**/*.json",
        "{workspaceRoot}/scripts/sanity/content/initial-content.ndjson"
      ]
    }
  }
}
